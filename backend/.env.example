# =============================================================================
# Konfigurasi Lingkungan Backend Kopi Sadewo (Produksi & Pengembangan)
# =============================================================================

# Port Server Backend (Otomatis ditentukan oleh hosting seperti Render/Railway)
PORT=5000

# URL Koneksi PostgreSQL (Contoh dari Supabase, Neon.tech, atau PostgreSQL lokal)
# Format: postgresql://<username>:<password>@<host>:<port>/<database>?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kopisadewodev

# JWT Secret untuk Autentikasi Admin (Ganti dengan string rahasia yang acak & kuat)
JWT_SECRET=sadewo_kopi_super_secret_jwt_key_2026_prod

# Domain Frontend yang diizinkan untuk CORS (Alamat rilis frontend di Vercel/Netlify)
# Contoh: https://kopisadewo.vercel.app atau https://kopisadewo.com
FRONTEND_URL=https://kopisadewo.vercel.app

# Akun Admin Cadangan (Digunakan bila database PostgreSQL belum tersambung)
ADMIN_EMAIL=admin@kopisadewo.com
ADMIN_PASSWORD=SadewoAdmin2026!
